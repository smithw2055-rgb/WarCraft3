<UserControl
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Width="1280"
  Height="720">
  <Grid Background="#00000000">
    <Border x:Name="SmokeTopLeft"
            Width="360"
            Height="120"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="24"
            Background="#E6FF2020"
            BorderBrush="#FFFFFF00"
            BorderThickness="6">
      <TextBlock Text="NOESIS XAML SMOKE TEST"
                 Foreground="#FFFFFFFF"
                 FontSize="28"
                 FontWeight="Bold"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>
    </Border>

    <Border x:Name="SmokeBottomHud"
            Height="190"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Margin="16"
            Background="#E62060FF"
            BorderBrush="#FF00FF66"
            BorderThickness="6">
      <Grid Margin="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="MinimapViewport"
                Background="#FF101010"
                BorderBrush="#FFFFFFFF"
                BorderThickness="4">
          <Grid x:Name="MinimapContentViewport" Margin="8"/>
        </Border>
        <TextBlock Grid.Column="1"
                   Text="If this blue bottom bar and red top box are visible, Noesis rendering works."
                   Foreground="#FFFFFFFF"
                   FontSize="24"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Margin="24,0,0,0"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
