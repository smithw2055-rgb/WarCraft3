<UserControl
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:War3UI"
  x:Class="War3UI.GlueMenuControl"
  x:Name="GlueMenuControl">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="GlueMenuResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid x:Name="GlueMenuRoot" Background="#00000000">
    <local:MdxSceneControl x:Name="GlueMdxBackground"
                           SceneKey="GlueMainMenuBackground"
                           Stretch="UniformToFill"
                           IsActive="True"
                           IsHitTestVisible="False"/>
    <local:MainMenuBackdropControl/>
    <Viewbox Stretch="UniformToFill" IsHitTestVisible="False">
      <Grid Width="1536" Height="1152">
        <Canvas x:Name="GlueNightElfBackdropLayer" Visibility="Collapsed">
          <Rectangle Width="1536" Height="1152" Fill="#8A000000"/>
          <Rectangle Canvas.Left="-110" Canvas.Top="560" Width="1760" Height="600"
                     Fill="{StaticResource SinglePlayerNightElfGroundBrush}" Opacity="0.58"/>
          <Rectangle Canvas.Left="-80" Canvas.Top="700" Width="720" Height="430"
                     Fill="{StaticResource SinglePlayerNightElfDetailsBrush}" Opacity="0.42"/>
          <Rectangle Canvas.Left="520" Canvas.Top="650" Width="760" Height="500"
                     Fill="{StaticResource SinglePlayerNightElfDetailsBrush}" Opacity="0.24"/>
          <Rectangle Canvas.Left="120" Canvas.Top="132" Width="360" Height="360"
                     Fill="{StaticResource SinglePlayerNightElfMoonGlowBrush}" Opacity="0.34"/>
          <Rectangle Canvas.Left="88" Canvas.Top="96" Width="96" Height="96"
                     Fill="{StaticResource SinglePlayerNightElfStarAlphaBrush}" Opacity="0.50"/>
          <Rectangle Canvas.Left="285" Canvas.Top="88" Width="74" Height="74"
                     Fill="{StaticResource SinglePlayerNightElfStarAlphaBrush}" Opacity="0.34"/>
          <Rectangle Canvas.Left="430" Canvas.Top="188" Width="56" Height="56"
                     Fill="{StaticResource SinglePlayerNightElfStarAlphaBrush}" Opacity="0.26"/>
          <Rectangle Canvas.Left="0" Canvas.Top="0" Width="1536" Height="1152" Fill="#66030912"/>
        </Canvas>
      </Grid>
    </Viewbox>
    <Viewbox Stretch="Uniform">
      <Grid Width="1536" Height="1152" Background="Transparent">
        <Canvas>
          <Border Canvas.Left="1160" Canvas.Top="1090" Width="310" Height="34"
                  Background="#AA000000" BorderBrush="#FF5E4B2A" BorderThickness="1"
                  Visibility="Collapsed">
            <TextBlock x:Name="GlueMenuStateText"
                       Text="MainMenuFrame"
                       Foreground="#FFC7B780"
                       FontSize="16"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
          </Border>
        </Canvas>

        <local:MainMenuPanelControl x:Name="MainMenuFrame" Width="1536" Height="1152" Visibility="Visible"/>
        <local:SinglePlayerPanelControl x:Name="SinglePlayerMenu" Width="1536" Height="1152" Visibility="Collapsed"/>

        <local:CampaignPanelControl x:Name="CampaignMenu" Width="1536" Height="1152" Visibility="Collapsed"/>

        <local:CustomGamePanelControl x:Name="CustomGameMenu" Width="1536" Height="1152" Visibility="Collapsed"/>
      </Grid>
    </Viewbox>
  </Grid>
</UserControl>

