                      <TextBlock x:Name="SelectedMapPageText" Text="Map 1 of 1" Foreground="#FFCAB77A" FontSize="16" Margin="0,4,0,0"/>
                      <TextBlock x:Name="SelectedMapPathText" Text="Maps/FrozenThrone" Foreground="#FFCAB77A" FontSize="15" TextWrapping="Wrap" Margin="0,4,0,0"/>
                      <TextBlock x:Name="SelectedMapDescriptionText" Text="Small island duel map. Map preview and W3I details pending." Foreground="#FFCAB77A" FontSize="16" TextWrapping="Wrap" Margin="0,8,0,0"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border x:Name="AdvancedOptionsPane" Height="230" Background="{StaticResource GluePanelExpansionDetailBrush}" BorderThickness="0" Visibility="Collapsed">
                    <Grid>
                      <Border Background="#CC05070A" Margin="10"/>
                      <Border Background="{StaticResource GluePanelRailBrush}" HorizontalAlignment="Left" Width="10" Opacity="0.75"/>
                      <StackPanel Margin="18">
                      <TextBlock Text="ADVANCED OPTIONS" Foreground="#FFE7D184" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                      <Border x:Name="TeamsTogetherToggleButton" Height="42" Margin="0,0,0,8" Style="{StaticResource GlueButtonChromeStyle}" BorderThickness="0">
                        <Grid>
                          <Border Margin="18,8" Style="{StaticResource GlueButtonFillStyle}"/>
                          <Border Margin="13,6" Style="{StaticResource GlueButtonFillStyle}"/>
                          <Border x:Name="GlueMenuButtonHoverTeamsTogetherToggleButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
                          <Border x:Name="GlueMenuButtonPressedTeamsTogetherToggleButton" Background="{StaticResource GlueButton1KeyHighlightBrush}" Visibility="Collapsed" Opacity="0.75"/>
                          <TextBlock Text="TEAMS TOGETHER" Foreground="#FFFFFFFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="24,0,70,0"/>
                          <TextBlock x:Name="TeamsTogetherToggleText" Text="On" Foreground="#FFE7D184" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,24,0"/>
                        </Grid>
                      </Border>
                      <Border x:Name="FixedTeamsToggleButton" Height="42" Margin="0,0,0,8" Style="{StaticResource GlueButtonChromeStyle}" BorderThickness="0">
                        <Grid>
                          <Border Margin="18,8" Style="{StaticResource GlueButtonFillStyle}"/>
                          <Border Margin="13,6" Style="{StaticResource GlueButtonFillStyle}"/>
                          <Border x:Name="GlueMenuButtonHoverFixedTeamsToggleButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
                          <Border x:Name="GlueMenuButtonPressedFixedTeamsToggleButton" Background="{StaticResource GlueButton1KeyHighlightBrush}" Visibility="Collapsed" Opacity="0.75"/>
                          <TextBlock Text="FIXED TEAMS" Foreground="#FFFFFFFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="24,0,70,0"/>
                          <TextBlock x:Name="FixedTeamsToggleText" Text="Off" Foreground="#FFE7D184" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,24,0"/>
                        </Grid>
                      </Border>
                      <Border x:Name="FullSharedControlToggleButton" Height="42" Style="{StaticResource GlueButtonChromeStyle}" BorderThickness="0">
                        <Grid>
                          <Border Margin="18,8" Style="{StaticResource GlueButtonFillStyle}"/>
                          <Border Margin="13,6" Style="{StaticResource GlueButtonFillStyle}"/>
                          <Border x:Name="GlueMenuButtonHoverFullSharedControlToggleButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
                          <Border x:Name="GlueMenuButtonPressedFullSharedControlToggleButton" Background="{StaticResource GlueButton1KeyHighlightBrush}" Visibility="Collapsed" Opacity="0.75"/>
                          <TextBlock Text="FULL SHARED CONTROL" Foreground="#FFFFFFFF" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="24,0,70,0"/>
                          <TextBlock x:Name="FullSharedControlToggleText" Text="Off" Foreground="#FFE7D184" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,24,0"/>
                        </Grid>
                      </Border>
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Grid>
              <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Grid x:Name="PlayGameButton" Width="220" Height="52" Margin="0,0,16,0">
                  <Border Style="{StaticResource GlueButtonChromeStyle}"/>
                  <Border Margin="20,10" Style="{StaticResource GlueButtonFillStyle}"/>
                  <Border Margin="15,8" Style="{StaticResource GlueButtonFillStyle}"/>
                  <Border x:Name="GlueMenuButtonHoverPlayGameButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
                  <Border x:Name="GlueMenuButtonPressedPlayGameButton" Background="{StaticResource GlueButton1KeyHighlightBrush}" Visibility="Collapsed" Opacity="0.75"/>
                  <TextBlock Text="PLAY GAME" Foreground="#FFFFFFFF" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <Grid x:Name="SkirmishCancelButton" Width="220" Height="52">
                  <Border Style="{StaticResource GlueButtonChromeStyle}"/>
                  <Border Margin="20,10" Style="{StaticResource GlueButtonFillStyle}"/>
                  <Border Margin="15,8" Style="{StaticResource GlueButtonFillStyle}"/>
                  <Border x:Name="GlueMenuButtonHoverSkirmishCancelButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
                  <Border x:Name="GlueMenuButtonPressedSkirmishCancelButton" Background="{StaticResource GlueButton1KeyHighlightBrush}" Visibility="Collapsed" Opacity="0.75"/>
                  <TextBlock Text="CANCEL" Foreground="#FFFFFFFF" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
            </Grid>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Viewbox>
  </Grid>
</UserControl>
