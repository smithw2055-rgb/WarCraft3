<UserControl
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:War3UI"
  x:Class="War3UI.GlueMenuControl"
  x:Name="GlueMenuControl">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="War3UiResources.xaml"/>
        <ResourceDictionary Source="GlueMenuResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="GlueButtonChromeStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlueButton1BorderSingleBrush}"/>
      </Style>
      <Style x:Key="GlueButtonFillStyle" TargetType="Border">
        <Setter Property="Background" Value="#22000000"/>
      </Style>
      <Style x:Key="GlueButtonDisabledFillStyle" TargetType="Border">
        <Setter Property="Background" Value="#11000000"/>
      </Style>
      <Style x:Key="GluePanelFrameStyle" TargetType="Border">
        <Setter Property="Background" Value="#E805070A"/>
        <Setter Property="BorderBrush" Value="{StaticResource GluePanelMetalBorderExpansionBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
      </Style>
      <Style x:Key="GlueInsetPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="#CC05070A"/>
        <Setter Property="BorderBrush" Value="{StaticResource GluePanelRailBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid x:Name="GlueMenuRoot" Background="#FF05070A">
    <Viewbox Stretch="UniformToFill">
      <Grid Width="1536" Height="1152" Background="#FF05070A">
        <Canvas>
          <Rectangle Width="1536" Height="1152" Fill="{StaticResource MainMenuSkyBrush}"/>
          <Rectangle Canvas.Left="-110" Canvas.Top="-24" Width="1760" Height="560" Fill="{StaticResource MainMenuCloudsFadeBrush}" Opacity="0.55"/>
          <Rectangle Canvas.Left="-130" Canvas.Top="500" Width="1120" Height="520" Fill="{StaticResource MainMenuIcebergBrush}" Opacity="0.32"/>
          <Rectangle Canvas.Left="500" Canvas.Top="760" Width="890" Height="300" Fill="{StaticResource MainMenuIceDullBrush}" Opacity="0.16"/>
          <Rectangle Canvas.Left="0" Canvas.Top="0" Width="1536" Height="1152" Fill="#A6000000"/>
          <Rectangle Canvas.Left="760" Canvas.Top="142" Width="720" Height="380" Fill="{StaticResource MainMenuBlueGlowBrush}" Opacity="0.24"/>
        </Canvas>
      </Grid>
    </Viewbox>
    <Viewbox Stretch="Uniform">
      <Grid Width="1536" Height="1152" Background="Transparent">
        <Canvas>
          <Rectangle Canvas.Left="820" Canvas.Top="66" Width="584" Height="292" Fill="{StaticResource War3xLogoBrush}"/>

          <Border Canvas.Left="1160" Canvas.Top="1090" Width="310" Height="34"
                  Background="#AA000000" BorderBrush="#FF5E4B2A" BorderThickness="1"
                  Visibility="Collapsed">
            <TextBlock x:Name="GlueMenuStateText"
                       Text="MainMenuFrame"
                       Foreground="#FFC7B780"
                       FontSize="16"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
          </Border>
        </Canvas>

        <Grid x:Name="MainMenuFrame" Width="1536" Height="1152" Visibility="Visible">
          <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,130,150,0" Width="340">
            <Grid x:Name="SinglePlayerButton" Height="58" Margin="0,0,0,12">
              <Border Style="{StaticResource GlueButtonChromeStyle}"/>
              <Border Margin="28,11" Style="{StaticResource GlueButtonFillStyle}"/>
              <Border Margin="22,9" Style="{StaticResource GlueButtonFillStyle}"/>
              <Border x:Name="GlueMenuButtonHoverSinglePlayerButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
              <Border x:Name="GlueMenuButtonPressedSinglePlayerButton" Background="{StaticResource GlueButton1KeyHighlightBrush}" Visibility="Collapsed" Opacity="0.75"/>
              <TextBlock Text="SINGLE PLAYER" Foreground="#FFFFFFFF" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <Grid x:Name="BattleNetButton" Height="58" Margin="0,0,0,12" Opacity="0.55">
              <Border Style="{StaticResource GlueButtonChromeStyle}"/>
              <Border Margin="28,11" Style="{StaticResource GlueButtonDisabledFillStyle}"/>
              <Border Margin="22,9" Style="{StaticResource GlueButtonDisabledFillStyle}"/>
              <TextBlock Text="BATTLE.NET" Foreground="#FF777777" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <Grid x:Name="LocalAreaNetworkButton" Height="58" Margin="0,0,0,12" Opacity="0.55">
              <Border Style="{StaticResource GlueButtonChromeStyle}"/>
              <Border Margin="28,11" Style="{StaticResource GlueButtonDisabledFillStyle}"/>
              <Border Margin="22,9" Style="{StaticResource GlueButtonDisabledFillStyle}"/>
              <TextBlock Text="LOCAL AREA NETWORK" Foreground="#FF777777" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <Grid x:Name="OptionsButton" Height="58" Margin="0,0,0,12">
              <Border Style="{StaticResource GlueButtonChromeStyle}"/>
              <Border Margin="28,11" Style="{StaticResource GlueButtonFillStyle}"/>
              <Border Margin="22,9" Style="{StaticResource GlueButtonFillStyle}"/>
              <Border x:Name="GlueMenuButtonHoverOptionsButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
              <Border x:Name="GlueMenuButtonPressedOptionsButton" Background="{StaticResource GlueButton1KeyHighlightBrush}" Visibility="Collapsed" Opacity="0.75"/>
              <TextBlock Text="OPTIONS" Foreground="#FFFFFFFF" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <Grid x:Name="CreditsButton" Height="58" Margin="0,0,0,12" Opacity="0.55">
              <Border Style="{StaticResource GlueButtonChromeStyle}"/>
              <Border Margin="28,11" Style="{StaticResource GlueButtonDisabledFillStyle}"/>
              <Border Margin="22,9" Style="{StaticResource GlueButtonDisabledFillStyle}"/>
              <TextBlock Text="CREDITS" Foreground="#FF777777" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <Grid x:Name="ExitButton" Height="58">
              <Border Style="{StaticResource GlueButtonChromeStyle}"/>
              <Border Margin="28,11" Style="{StaticResource GlueButtonFillStyle}"/>
              <Border Margin="22,9" Style="{StaticResource GlueButtonFillStyle}"/>
              <Border x:Name="GlueMenuButtonHoverExitButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
              <Border x:Name="GlueMenuButtonPressedExitButton" Background="{StaticResource GlueButton1KeyHighlightBrush}" Visibility="Collapsed" Opacity="0.75"/>
              <TextBlock Text="EXIT" Foreground="#FFFFFFFF" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </StackPanel>
        </Grid>

        <Grid x:Name="SinglePlayerMenu" Width="1536" Height="1152" Visibility="Collapsed">
          <Border Width="610" Height="680" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,90,118,0"
                  Style="{StaticResource GluePanelFrameStyle}">
            <Grid>
              <Border Background="{StaticResource GluePanelExpansionDetailBrush}" Opacity="0.55"/>
              <Border Margin="18" Background="#CC08090A"/>
            <Grid Margin="36">
              <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="76"/>
              </Grid.RowDefinitions>
              <TextBlock Text="SINGLE PLAYER" Foreground="#FFE7D184" FontSize="34" FontWeight="Bold" VerticalAlignment="Top"/>
              <StackPanel Grid.Row="1" Width="390" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,0,0">
                <Grid x:Name="ProfileButton" Height="50" Margin="0,0,0,10">
                  <Border Style="{StaticResource GlueButtonChromeStyle}"/>
                  <Border Margin="24,10" Style="{StaticResource GlueButtonFillStyle}"/>
                  <Border Margin="18,8" Style="{StaticResource GlueButtonFillStyle}"/>
                  <TextBlock Text="PROFILE" Foreground="#FFFFFFFF" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <Grid x:Name="CampaignButton" Height="50" Margin="0,0,0,10">
                  <Border Style="{StaticResource GlueButtonChromeStyle}"/>
                  <Border Margin="24,10" Style="{StaticResource GlueButtonFillStyle}"/>
                  <Border Margin="18,8" Style="{StaticResource GlueButtonFillStyle}"/>
                  <Border x:Name="GlueMenuButtonHoverCampaignButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
                  <Border x:Name="GlueMenuButtonPressedCampaignButton" Background="{StaticResource GlueButton1KeyHighlightBrush}" Visibility="Collapsed" Opacity="0.75"/>
                  <TextBlock Text="CAMPAIGN" Foreground="#FFFFFFFF" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <Grid x:Name="LoadSavedButton" Height="50" Margin="0,0,0,10" Opacity="0.55">
                  <Border Style="{StaticResource GlueButtonChromeStyle}"/>
                  <Border Margin="24,10" Style="{StaticResource GlueButtonDisabledFillStyle}"/>
                  <Border Margin="18,8" Style="{StaticResource GlueButtonDisabledFillStyle}"/>
                  <TextBlock Text="LOAD SAVED GAME" Foreground="#FF777777" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <Grid x:Name="ViewReplayButton" Height="50" Margin="0,0,0,10" Opacity="0.55">
                  <Border Style="{StaticResource GlueButtonChromeStyle}"/>
                  <Border Margin="24,10" Style="{StaticResource GlueButtonDisabledFillStyle}"/>
                  <Border Margin="18,8" Style="{StaticResource GlueButtonDisabledFillStyle}"/>
                  <TextBlock Text="VIEW REPLAY" Foreground="#FF777777" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <Grid x:Name="CustomCampaignButton" Height="50" Margin="0,0,0,10" Opacity="0.55">
                  <Border Style="{StaticResource GlueButtonChromeStyle}"/>
                  <Border Margin="24,10" Style="{StaticResource GlueButtonDisabledFillStyle}"/>
                  <Border Margin="18,8" Style="{StaticResource GlueButtonDisabledFillStyle}"/>
                  <TextBlock Text="CUSTOM CAMPAIGN" Foreground="#FF777777" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <Grid x:Name="SkirmishButton" Height="50">
                  <Border Style="{StaticResource GlueButtonChromeStyle}"/>
                  <Border Margin="24,10" Style="{StaticResource GlueButtonFillStyle}"/>
                  <Border Margin="18,8" Style="{StaticResource GlueButtonFillStyle}"/>
                  <Border x:Name="GlueMenuButtonHoverSkirmishButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
                  <Border x:Name="GlueMenuButtonPressedSkirmishButton" Background="{StaticResource GlueButton1KeyHighlightBrush}" Visibility="Collapsed" Opacity="0.75"/>
                  <TextBlock Text="CUSTOM GAME" Foreground="#FFFFFFFF" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
              <Grid x:Name="CancelButton" Grid.Row="2" Width="220" Height="52" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Border Style="{StaticResource GlueButtonChromeStyle}"/>
                <Border Margin="20,10" Style="{StaticResource GlueButtonFillStyle}"/>
                <Border Margin="15,8" Style="{StaticResource GlueButtonFillStyle}"/>
                <Border x:Name="GlueMenuButtonHoverCancelButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
                <Border x:Name="GlueMenuButtonPressedCancelButton" Background="{StaticResource GlueButton1KeyHighlightBrush}" Visibility="Collapsed" Opacity="0.75"/>
                <TextBlock Text="CANCEL" Foreground="#FFFFFFFF" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </Grid>
            </Grid>
          </Border>
        </Grid>

        <Grid x:Name="CampaignMenu" Width="1536" Height="1152" Visibility="Collapsed">
          <Border x:Name="CampaignSelectFrame" Width="760" Height="660" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,104,118,0"
                  Style="{StaticResource GluePanelFrameStyle}">
            <Grid>
              <Border Background="{StaticResource GluePanelExpansionDetailBrush}" Opacity="0.55"/>
              <Border Margin="18" Background="#CC08090A"/>
            <Grid Margin="34">
              <Grid.RowDefinitions>
                <RowDefinition Height="84"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="72"/>
              </Grid.RowDefinitions>
              <TextBlock Text="CAMPAIGN" Foreground="#FFE7D184" FontSize="34" FontWeight="Bold"/>
              <Grid x:Name="CampaignRootMenuUI" Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="300"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <Border x:Name="CampaignPrologueButton" Height="46" Margin="0,0,0,8" Style="{StaticResource GlueButtonChromeStyle}" BorderThickness="0">
                    <Grid>
                      <Border Margin="20,9" Style="{StaticResource GlueButtonFillStyle}"/>
                      <Border Margin="15,7" Style="{StaticResource GlueButtonFillStyle}"/>
                      <Border x:Name="GlueMenuButtonHoverCampaignPrologueButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
                      <Border x:Name="GlueMenuButtonPressedCampaignPrologueButton" Background="{StaticResource GlueButton1KeyHighlightBrush}" Visibility="Collapsed" Opacity="0.75"/>
                      <TextBlock x:Name="CampaignPrologueButtonText" Text="PROLOGUE" Foreground="#FFFFFFFF" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                  </Border>
                  <Border x:Name="CampaignHumanButton" Height="46" Margin="0,0,0,8" Style="{StaticResource GlueButtonChromeStyle}" BorderThickness="0">
                    <Grid>
                      <Border Margin="20,9" Style="{StaticResource GlueButtonFillStyle}"/>
                      <Border Margin="15,7" Style="{StaticResource GlueButtonFillStyle}"/>
                      <Border x:Name="GlueMenuButtonHoverCampaignHumanButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
                      <Border x:Name="GlueMenuButtonPressedCampaignHumanButton" Background="{StaticResource GlueButton1KeyHighlightBrush}" Visibility="Collapsed" Opacity="0.75"/>
                      <TextBlock x:Name="CampaignHumanButtonText" Text="HUMAN" Foreground="#FFFFFFFF" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                  </Border>
                  <Border x:Name="CampaignUndeadButton" Height="46" Margin="0,0,0,8" Style="{StaticResource GlueButtonChromeStyle}" BorderThickness="0">
                    <Grid>
                      <Border Margin="20,9" Style="{StaticResource GlueButtonFillStyle}"/>
                      <Border Margin="15,7" Style="{StaticResource GlueButtonFillStyle}"/>
                      <Border x:Name="GlueMenuButtonHoverCampaignUndeadButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
                      <Border x:Name="GlueMenuButtonPressedCampaignUndeadButton" Background="{StaticResource GlueButton1KeyHighlightBrush}" Visibility="Collapsed" Opacity="0.75"/>
                      <TextBlock x:Name="CampaignUndeadButtonText" Text="UNDEAD" Foreground="#FFFFFFFF" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                  </Border>
                  <Border x:Name="CampaignOrcButton" Height="46" Margin="0,0,0,8" Style="{StaticResource GlueButtonChromeStyle}" BorderThickness="0">
                    <Grid>
                      <Border Margin="20,9" Style="{StaticResource GlueButtonFillStyle}"/>
                      <Border Margin="15,7" Style="{StaticResource GlueButtonFillStyle}"/>
                      <Border x:Name="GlueMenuButtonHoverCampaignOrcButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
                      <Border x:Name="GlueMenuButtonPressedCampaignOrcButton" Background="{StaticResource GlueButton1KeyHighlightBrush}" Visibility="Collapsed" Opacity="0.75"/>
                      <TextBlock x:Name="CampaignOrcButtonText" Text="ORC" Foreground="#FFFFFFFF" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                  </Border>
                  <Border x:Name="CampaignNightElfButton" Height="46" Style="{StaticResource GlueButtonChromeStyle}" BorderThickness="0">
                    <Grid>
                      <Border Margin="20,9" Style="{StaticResource GlueButtonFillStyle}"/>
                      <Border Margin="15,7" Style="{StaticResource GlueButtonFillStyle}"/>
                      <Border x:Name="GlueMenuButtonHoverCampaignNightElfButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
                      <Border x:Name="GlueMenuButtonPressedCampaignNightElfButton" Background="{StaticResource GlueButton1KeyHighlightBrush}" Visibility="Collapsed" Opacity="0.75"/>
                      <TextBlock x:Name="CampaignNightElfButtonText" Text="NIGHT ELF" Foreground="#FFFFFFFF" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                  </Border>
                </StackPanel>
                <Grid x:Name="CampaignMissionSelectMenuUI" Grid.Column="1" Margin="28,0,0,0" Visibility="Collapsed">
                  <Border Background="#AA000000" BorderBrush="#FF5E4B2A" BorderThickness="1"/>
                  <StackPanel Margin="24">
                    <TextBlock x:Name="CampaignMissionHeaderText" Text="PROLOGUE" Foreground="#FFE7D184" FontSize="23" FontWeight="Bold"/>
                    <TextBlock x:Name="CampaignMissionNameText" Text="EXODUS OF THE HORDE" Foreground="#FFFFFFFF" FontSize="20" Margin="0,6,0,16"/>
                    <Border x:Name="CampaignMissionOneButton" Height="32" Margin="0,0,0,6" Style="{StaticResource GlueButtonChromeStyle}" BorderThickness="0">
                      <Grid>
                        <Border Margin="14,6" Style="{StaticResource GlueButtonFillStyle}"/>
                        <Border Margin="10,5" Style="{StaticResource GlueButtonFillStyle}"/>
                        <Border x:Name="GlueMenuButtonHoverCampaignMissionOneButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
                        <Border x:Name="GlueMenuButtonPressedCampaignMissionOneButton" Background="{StaticResource GlueButton1KeyHighlightBrush}" Visibility="Collapsed" Opacity="0.75"/>
                        <TextBlock x:Name="CampaignMissionOneButtonText" Text="01  CHASING VISIONS" Foreground="#FFFFFFFF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                      </Grid>
                    </Border>
                    <Border x:Name="CampaignMissionTwoButton" Height="32" Margin="0,0,0,6" Style="{StaticResource GlueButtonChromeStyle}" BorderThickness="0">
                      <Grid>
                        <Border Margin="14,6" Style="{StaticResource GlueButtonFillStyle}"/>
                        <Border Margin="10,5" Style="{StaticResource GlueButtonFillStyle}"/>
                        <Border x:Name="GlueMenuButtonHoverCampaignMissionTwoButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
                        <Border x:Name="GlueMenuButtonPressedCampaignMissionTwoButton" Background="{StaticResource GlueButton1KeyHighlightBrush}" Visibility="Collapsed" Opacity="0.75"/>
                        <TextBlock x:Name="CampaignMissionTwoButtonText" Text="02  DEPARTURES" Foreground="#FFFFFFFF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                      </Grid>
                    </Border>
                    <Border x:Name="CampaignMission3Button" Height="32" Margin="0,0,0,6" Style="{StaticResource GlueButtonChromeStyle}" BorderThickness="0">
                      <Grid>
                        <Border Margin="14,6" Style="{StaticResource GlueButtonFillStyle}"/>
                        <Border Margin="10,5" Style="{StaticResource GlueButtonFillStyle}"/>
                        <Border x:Name="GlueMenuButtonHoverCampaignMission3Button" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
                        <Border x:Name="GlueMenuButtonPressedCampaignMission3Button" Background="{StaticResource GlueButton1KeyHighlightBrush}" Visibility="Collapsed" Opacity="0.75"/>
                        <TextBlock x:Name="CampaignMission3ButtonText" Text="03" Foreground="#FFFFFFFF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                      </Grid>
                    </Border>
                    <Border x:Name="CampaignMission4Button" Height="32" Margin="0,0,0,6" Style="{StaticResource GlueButtonChromeStyle}" BorderThickness="0">
                      <Grid>
                        <Border Margin="14,6" Style="{StaticResource GlueButtonFillStyle}"/>
                        <Border Margin="10,5" Style="{StaticResource GlueButtonFillStyle}"/>
                        <Border x:Name="GlueMenuButtonHoverCampaignMission4Button" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
                        <Border x:Name="GlueMenuButtonPressedCampaignMission4Button" Background="{StaticResource GlueButton1KeyHighlightBrush}" Visibility="Collapsed" Opacity="0.75"/>
                        <TextBlock x:Name="CampaignMission4ButtonText" Text="04" Foreground="#FFFFFFFF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                      </Grid>
                    </Border>
                    <Border x:Name="CampaignMission5Button" Height="32" Margin="0,0,0,6" Style="{StaticResource GlueButtonChromeStyle}" BorderThickness="0">
                      <Grid>
                        <Border Margin="14,6" Style="{StaticResource GlueButtonFillStyle}"/>
                        <Border Margin="10,5" Style="{StaticResource GlueButtonFillStyle}"/>
                        <Border x:Name="GlueMenuButtonHoverCampaignMission5Button" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
                        <Border x:Name="GlueMenuButtonPressedCampaignMission5Button" Background="{StaticResource GlueButton1KeyHighlightBrush}" Visibility="Collapsed" Opacity="0.75"/>
                        <TextBlock x:Name="CampaignMission5ButtonText" Text="05" Foreground="#FFFFFFFF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                      </Grid>
                    </Border>
                    <Border x:Name="CampaignMission6Button" Height="32" Margin="0,0,0,6" Style="{StaticResource GlueButtonChromeStyle}" BorderThickness="0">
                      <Grid>
                        <Border Margin="14,6" Style="{StaticResource GlueButtonFillStyle}"/>
                        <Border Margin="10,5" Style="{StaticResource GlueButtonFillStyle}"/>
                        <Border x:Name="GlueMenuButtonHoverCampaignMission6Button" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
                        <Border x:Name="GlueMenuButtonPressedCampaignMission6Button" Background="{StaticResource GlueButton1KeyHighlightBrush}" Visibility="Collapsed" Opacity="0.75"/>
                        <TextBlock x:Name="CampaignMission6ButtonText" Text="06" Foreground="#FFFFFFFF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                      </Grid>
                    </Border>
                    <Border x:Name="CampaignMission7Button" Height="32" Margin="0,0,0,6" Style="{StaticResource GlueButtonChromeStyle}" BorderThickness="0">
                      <Grid>
                        <Border Margin="14,6" Style="{StaticResource GlueButtonFillStyle}"/>
                        <Border Margin="10,5" Style="{StaticResource GlueButtonFillStyle}"/>
                        <Border x:Name="GlueMenuButtonHoverCampaignMission7Button" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
                        <Border x:Name="GlueMenuButtonPressedCampaignMission7Button" Background="{StaticResource GlueButton1KeyHighlightBrush}" Visibility="Collapsed" Opacity="0.75"/>
                        <TextBlock x:Name="CampaignMission7ButtonText" Text="07" Foreground="#FFFFFFFF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                      </Grid>
                    </Border>
                    <Border x:Name="CampaignMission8Button" Height="32" Margin="0,0,0,6" Style="{StaticResource GlueButtonChromeStyle}" BorderThickness="0">
                      <Grid>
                        <Border Margin="14,6" Style="{StaticResource GlueButtonFillStyle}"/>
                        <Border Margin="10,5" Style="{StaticResource GlueButtonFillStyle}"/>
                        <Border x:Name="GlueMenuButtonHoverCampaignMission8Button" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
                        <Border x:Name="GlueMenuButtonPressedCampaignMission8Button" Background="{StaticResource GlueButton1KeyHighlightBrush}" Visibility="Collapsed" Opacity="0.75"/>
                        <TextBlock x:Name="CampaignMission8ButtonText" Text="08" Foreground="#FFFFFFFF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                      </Grid>
                    </Border>
                    <Border x:Name="CampaignMission9Button" Height="32" Margin="0,0,0,6" Style="{StaticResource GlueButtonChromeStyle}" BorderThickness="0">
                      <Grid>
                        <Border Margin="14,6" Style="{StaticResource GlueButtonFillStyle}"/>
                        <Border Margin="10,5" Style="{StaticResource GlueButtonFillStyle}"/>
                        <Border x:Name="GlueMenuButtonHoverCampaignMission9Button" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
                        <Border x:Name="GlueMenuButtonPressedCampaignMission9Button" Background="{StaticResource GlueButton1KeyHighlightBrush}" Visibility="Collapsed" Opacity="0.75"/>
                        <TextBlock x:Name="CampaignMission9ButtonText" Text="09" Foreground="#FFFFFFFF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                      </Grid>
                    </Border>
                    <Border x:Name="CampaignMission10Button" Height="32" Margin="0,0,0,6" Style="{StaticResource GlueButtonChromeStyle}" BorderThickness="0">
                      <Grid>
                        <Border Margin="14,6" Style="{StaticResource GlueButtonFillStyle}"/>
                        <Border Margin="10,5" Style="{StaticResource GlueButtonFillStyle}"/>
                        <Border x:Name="GlueMenuButtonHoverCampaignMission10Button" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
                        <Border x:Name="GlueMenuButtonPressedCampaignMission10Button" Background="{StaticResource GlueButton1KeyHighlightBrush}" Visibility="Collapsed" Opacity="0.75"/>
                        <TextBlock x:Name="CampaignMission10ButtonText" Text="10" Foreground="#FFFFFFFF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                      </Grid>
                    </Border>
                    <Border x:Name="CampaignMission11Button" Height="32" Margin="0,0,0,6" Style="{StaticResource GlueButtonChromeStyle}" BorderThickness="0">
                      <Grid>
                        <Border Margin="14,6" Style="{StaticResource GlueButtonFillStyle}"/>
