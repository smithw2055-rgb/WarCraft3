<Canvas x:Name="UpperButtonBarFrame"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Width="652.8"
        Height="42.24"
        Margin="0,0,0,0">
  <Border x:Name="UpperButtonBarQuestsButton" Canvas.Left="3.84" Width="163.2" Height="42.24" IsHitTestVisible="False">
    <Grid>
      <Image Source="{StaticResource UpperMenuButtonDisabledBackgroundCrop}" Stretch="Fill"/>
      <Image x:Name="UpperButtonBarQuestsPushed" Source="{StaticResource UpperMenuButtonPushedBackgroundCrop}" Stretch="Fill" Visibility="Collapsed"/>
      <Image x:Name="UpperButtonBarQuestsHighlight" Source="{StaticResource UpperMenuButtonHighlightCrop}" Stretch="Fill" Visibility="Collapsed"/>
      <TextBlock x:Name="UpperButtonBarQuestsText" Text="QUESTS" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF666666" FontSize="14" FontWeight="Bold"/>
    </Grid>
  </Border>
  <Border x:Name="UpperButtonBarMenuButton" Canvas.Left="167.04" Width="163.2" Height="42.24" IsHitTestVisible="False">
    <Grid>
      <Image Source="{StaticResource UpperMenuButtonBackgroundCrop}" Stretch="Fill"/>
      <Image x:Name="UpperButtonBarMenuPushed" Source="{StaticResource UpperMenuButtonPushedBackgroundCrop}" Stretch="Fill" Visibility="Collapsed"/>
      <Image x:Name="UpperButtonBarMenuHighlight" Source="{StaticResource UpperMenuButtonHighlightCrop}" Stretch="Fill" Visibility="Collapsed"/>
      <TextBlock x:Name="UpperButtonBarMenuText" Text="MENU" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" FontSize="14" FontWeight="Bold"/>
    </Grid>
  </Border>
  <Border x:Name="UpperButtonBarAlliesButton" Canvas.Left="330.24" Width="163.2" Height="42.24" IsHitTestVisible="False">
    <Grid>
      <Image Source="{StaticResource UpperMenuButtonDisabledBackgroundCrop}" Stretch="Fill"/>
      <Image x:Name="UpperButtonBarAlliesPushed" Source="{StaticResource UpperMenuButtonPushedBackgroundCrop}" Stretch="Fill" Visibility="Collapsed"/>
      <Image x:Name="UpperButtonBarAlliesHighlight" Source="{StaticResource UpperMenuButtonHighlightCrop}" Stretch="Fill" Visibility="Collapsed"/>
      <TextBlock x:Name="UpperButtonBarAlliesText" Text="ALLIES" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF666666" FontSize="14" FontWeight="Bold"/>
    </Grid>
  </Border>
  <Border x:Name="UpperButtonBarChatButton" Canvas.Left="493.44" Width="163.2" Height="42.24" IsHitTestVisible="False">
    <Grid>
      <Image Source="{StaticResource UpperMenuButtonDisabledBackgroundCrop}" Stretch="Fill"/>
      <Image x:Name="UpperButtonBarChatPushed" Source="{StaticResource UpperMenuButtonPushedBackgroundCrop}" Stretch="Fill" Visibility="Collapsed"/>
      <Image x:Name="UpperButtonBarChatHighlight" Source="{StaticResource UpperMenuButtonHighlightCrop}" Stretch="Fill" Visibility="Collapsed"/>
      <TextBlock x:Name="UpperButtonBarChatText" Text="CHAT" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF666666" FontSize="14" FontWeight="Bold"/>
    </Grid>
  </Border>
</Canvas>
