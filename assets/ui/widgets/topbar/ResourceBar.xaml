<Canvas x:Name="ResourceBarFrame"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Width="649.5"
        Height="41.856"
        Margin="0,0,0,0">
  <Border Canvas.Left="0"
          Canvas.Top="6"
          Width="31.5"
          Height="31.5"
          Background="{StaticResource ResourceGoldIconBrush}"/>
  <TextBlock x:Name="ResourceBarGoldText"
             Canvas.Left="-4.5"
             Canvas.Top="6"
             Width="145.5"
             Height="31.5"
             TextAlignment="Right"
             Foreground="#FFF7E4A4"
             FontSize="19.2"
             FontWeight="Bold"/>
  <Border Canvas.Left="165"
          Canvas.Top="6"
          Width="31.5"
          Height="31.5"
          Background="{StaticResource ResourceLumberIconBrush}"/>
  <TextBlock x:Name="ResourceBarLumberText"
             Canvas.Left="162"
             Canvas.Top="6"
             Width="145.5"
             Height="31.5"
             TextAlignment="Right"
             Foreground="#FFD9F1BA"
             FontSize="19.2"
             FontWeight="Bold"/>
  <Border Canvas.Left="331.5"
          Canvas.Top="6"
          Width="31.5"
          Height="31.5"
          Background="{StaticResource ResourceSupplyIconBrush}"/>
  <TextBlock x:Name="ResourceBarSupplyText"
             Canvas.Left="328.5"
             Canvas.Top="6"
             Width="145.5"
             Height="31.5"
             TextAlignment="Right"
             Foreground="#FFF3F7FF"
             FontSize="19.2"
             FontWeight="Bold"/>
  <TextBlock x:Name="ResourceBarUpkeepText"
             Canvas.Left="477"
             Canvas.Top="10"
             Width="92"
             Height="24"
             TextAlignment="Center"
             Foreground="#FF66E8FF"
             FontSize="14.4"
             FontWeight="Bold"
             Text="No Upkeep"/>
  <Canvas x:Name="TimeOfDayIndicator"
          Canvas.Left="574"
          Canvas.Top="6"
          Width="72"
          Height="31.5"
          IsHitTestVisible="False">
    <TextBlock x:Name="TimeText"
               Width="72"
               Height="31.5"
               TextAlignment="Right"
               Foreground="#FFF0E6B4"
               FontSize="19.2"
               FontWeight="Bold"
               Text="12:00"/>
  </Canvas>
</Canvas>
