<UserControl
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="War3UI.SinglePlayerPanelControl">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../GlueMenuResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Width="1536" Height="1152">
    <Border Width="610" Height="680" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,90,118,0"
            Style="{StaticResource GluePanelFrameStyle}">
      <Grid>
        <Border Background="{StaticResource GluePanelMetalPiecesExpansionBrush}" Opacity="0.82"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="32"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource GluePanelSideRailStyle}"/>
          <Border Grid.Column="2" Style="{StaticResource GluePanelSideRailStyle}"/>
        </Grid>
        <Border Width="16" Height="128" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="26,30,0,0" Style="{StaticResource GluePanelRailCapStyle}"/>
        <Border Width="16" Height="128" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,30,26,0" Style="{StaticResource GluePanelRailCapStyle}"/>
        <Border Width="128" Height="64" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30,0,0,14" Style="{StaticResource GluePanelGearRailStyle}"/>
        <Border Width="128" Height="64" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,14" Style="{StaticResource GluePanelGearRailStyle}"/>
        <Border Margin="16" Background="{StaticResource GluePanelExpansionDetailBrush}" Opacity="0.50"/>
        <Border Margin="28" Background="#D0060709"/>
        <Grid Margin="36">
          <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="76"/>
          </Grid.RowDefinitions>
          <TextBlock Text="SINGLE PLAYER" Foreground="#FFE7D184" FontSize="34" FontWeight="Bold" VerticalAlignment="Top"/>
          <StackPanel Grid.Row="1" Width="390" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,0,0">
            <Grid x:Name="ProfileButton" Height="50" Margin="0,0,0,10">
              <Border Style="{StaticResource GlueButtonChromeStyle}"/>
              <Border Margin="24,10" Style="{StaticResource GlueButtonFillStyle}"/>
              <Border Margin="18,8" Style="{StaticResource GlueButtonFillStyle}"/>
              <Border x:Name="GlueMenuButtonHoverProfileButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
              <Border x:Name="GlueMenuButtonPressedProfileButton" Style="{StaticResource GlueButtonPressedFillStyle}" Visibility="Collapsed" Opacity="0.86"/>
              <TextBlock Text="PROFILE" Foreground="#FFFFFFFF" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <Grid x:Name="CampaignButton" Height="50" Margin="0,0,0,10">
              <Border Style="{StaticResource GlueButtonChromeStyle}"/>
              <Border Margin="24,10" Style="{StaticResource GlueButtonFillStyle}"/>
              <Border Margin="18,8" Style="{StaticResource GlueButtonFillStyle}"/>
              <Border x:Name="GlueMenuButtonHoverCampaignButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
              <Border x:Name="GlueMenuButtonPressedCampaignButton" Style="{StaticResource GlueButtonPressedFillStyle}" Visibility="Collapsed" Opacity="0.86"/>
              <TextBlock Text="CAMPAIGN" Foreground="#FFFFFFFF" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <Grid x:Name="LoadSavedButton" Height="50" Margin="0,0,0,10">
              <Border Style="{StaticResource GlueButtonChromeStyle}"/>
              <Border Margin="24,10" Style="{StaticResource GlueButtonFillStyle}"/>
              <Border Margin="18,8" Style="{StaticResource GlueButtonFillStyle}"/>
              <Border x:Name="GlueMenuButtonHoverLoadSavedButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
              <Border x:Name="GlueMenuButtonPressedLoadSavedButton" Style="{StaticResource GlueButtonPressedFillStyle}" Visibility="Collapsed" Opacity="0.86"/>
              <TextBlock Text="LOAD SAVED GAME" Foreground="#FFFFFFFF" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <Grid x:Name="ViewReplayButton" Height="50" Margin="0,0,0,10">
              <Border Style="{StaticResource GlueButtonChromeStyle}"/>
              <Border Margin="24,10" Style="{StaticResource GlueButtonFillStyle}"/>
              <Border Margin="18,8" Style="{StaticResource GlueButtonFillStyle}"/>
              <Border x:Name="GlueMenuButtonHoverViewReplayButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
              <Border x:Name="GlueMenuButtonPressedViewReplayButton" Style="{StaticResource GlueButtonPressedFillStyle}" Visibility="Collapsed" Opacity="0.86"/>
              <TextBlock Text="VIEW REPLAY" Foreground="#FFFFFFFF" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <Grid x:Name="CustomCampaignButton" Height="50" Margin="0,0,0,10">
              <Border Style="{StaticResource GlueButtonChromeStyle}"/>
              <Border Margin="24,10" Style="{StaticResource GlueButtonFillStyle}"/>
              <Border Margin="18,8" Style="{StaticResource GlueButtonFillStyle}"/>
              <Border x:Name="GlueMenuButtonHoverCustomCampaignButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
              <Border x:Name="GlueMenuButtonPressedCustomCampaignButton" Style="{StaticResource GlueButtonPressedFillStyle}" Visibility="Collapsed" Opacity="0.86"/>
              <TextBlock Text="CUSTOM CAMPAIGN" Foreground="#FFFFFFFF" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <Grid x:Name="CustomGameButton" Height="50">
              <Border Style="{StaticResource GlueButtonChromeStyle}"/>
              <Border Margin="24,10" Style="{StaticResource GlueButtonFillStyle}"/>
              <Border Margin="18,8" Style="{StaticResource GlueButtonFillStyle}"/>
              <Border x:Name="GlueMenuButtonHoverCustomGameButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
              <Border x:Name="GlueMenuButtonPressedCustomGameButton" Style="{StaticResource GlueButtonPressedFillStyle}" Visibility="Collapsed" Opacity="0.86"/>
              <TextBlock Text="CUSTOM GAME" Foreground="#FFFFFFFF" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </StackPanel>
          <Grid x:Name="CancelButton" Grid.Row="2" Width="220" Height="52" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Border Style="{StaticResource GlueButtonChromeStyle}"/>
            <Border Margin="20,10" Style="{StaticResource GlueButtonFillStyle}"/>
            <Border Margin="15,8" Style="{StaticResource GlueButtonFillStyle}"/>
            <Border x:Name="GlueMenuButtonHoverCancelButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
            <Border x:Name="GlueMenuButtonPressedCancelButton" Style="{StaticResource GlueButtonPressedFillStyle}" Visibility="Collapsed" Opacity="0.86"/>
            <TextBlock Text="CANCEL" Foreground="#FFFFFFFF" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>

