      <Grid Width="1536" Height="1152" Background="#FF05070A">
        <Grid x:Name="CampaignBackdropNightElfLayer">
          <Rectangle Width="1536" Height="1152" Fill="{StaticResource CampaignNightElfSkyBrush}" Opacity="0.56"/>
          <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="520" Fill="{StaticResource SinglePlayerNightElfGroundBrush}" Opacity="0.58"/>
          <Rectangle HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="620" Height="420" Fill="{StaticResource SinglePlayerNightElfDetailsBrush}" Opacity="0.44"/>
          <Rectangle HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,110,160,0" Width="280" Height="360" Fill="{StaticResource CampaignNightElfWaterfallBrush}" Opacity="0.26"/>
          <Rectangle HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,92,220,0" Width="196" Height="196" Fill="{StaticResource SinglePlayerNightElfMoonGlowBrush}" Opacity="0.30"/>
        </Grid>
        <Grid x:Name="CampaignBackdropHumanLayer" Visibility="Collapsed">
          <Rectangle Width="1536" Height="1152" Fill="{StaticResource CampaignHumanSkyBrush}" Opacity="0.58"/>
          <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="570" Fill="{StaticResource CampaignHumanGroundBrush}" Opacity="0.64"/>
          <Rectangle HorizontalAlignment="Left" VerticalAlignment="Center" Margin="120,110,0,0" Width="290" Height="290" Fill="{StaticResource CampaignHumanBloodElfBrush}" Opacity="0.54"/>
          <Rectangle HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,150,260,0" Width="260" Height="260" Fill="{StaticResource MainMenuBlueGlowBrush}" Opacity="0.20"/>
