        <Grid x:Name="CampaignBackdropUndeadLayer" Visibility="Collapsed">
          <Rectangle Width="1536" Height="1152" Fill="{StaticResource CampaignUndeadSkyBrush}" Opacity="0.70"/>
          <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="650" Fill="{StaticResource CampaignUndeadGroundBrush}" Opacity="0.60"/>
          <Rectangle HorizontalAlignment="Left" VerticalAlignment="Center" Margin="90,80,0,0" Width="340" Height="340" Fill="{StaticResource CampaignUndeadArthasCloakBrush}" Opacity="0.56"/>
          <Rectangle HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,80,210,0" Width="200" Height="200" Fill="{StaticResource MainMenuSnowflakeBrush}" Opacity="0.18"/>
        </Grid>
        <Grid x:Name="CampaignBackdropOrcLayer" Visibility="Collapsed">
          <Rectangle Width="1536" Height="1152" Fill="{StaticResource CampaignOrcSkyBrush}" Opacity="0.58"/>
          <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="610" Fill="{StaticResource CampaignOrcGroundBrush}" Opacity="0.62"/>
          <Rectangle HorizontalAlignment="Left" VerticalAlignment="Center" Margin="96,110,0,0" Width="360" Height="360" Fill="{StaticResource CampaignOrcRexxarBrush}" Opacity="0.54"/>
