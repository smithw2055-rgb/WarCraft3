              <Border x:Name="GlueMenuButtonPressedCampaignNightElfButton" Grid.ColumnSpan="2" Style="{StaticResource GlueButtonPressedFillStyle}" Visibility="Collapsed" Opacity="0.86"/>
            </Grid>
