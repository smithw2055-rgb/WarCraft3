<UserControl
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="War3UI.GlueLocalAreaNetworkPanelControl">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../GlueMenuResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Width="1536" Height="1152">
    <Canvas>
      <Grid Canvas.Left="246" Canvas.Top="160" Width="1044" Height="768">
        <Border Style="{StaticResource GluePanelFrameStyle}"/>
        <Border Margin="18" Background="{StaticResource GluePanelMetalPiecesExpansionBrush}" Opacity="0.78"/>
        <Border Margin="34" Background="#EA05070A" BorderBrush="#FF283038" BorderThickness="2"/>

        <Grid Margin="74,62,74,62">
          <Grid.RowDefinitions>
            <RowDefinition Height="118"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="98"/>
          </Grid.RowDefinitions>

          <Grid>
            <Rectangle HorizontalAlignment="Left" Width="230" Height="2" VerticalAlignment="Bottom" Fill="#FF5E4B2A"/>
            <TextBlock Text="Local Area Network" Foreground="#FFFCD412" FontSize="38" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Text="Available Games" Foreground="#FFFFFFFF" FontSize="17"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
            <Rectangle HorizontalAlignment="Right" Width="230" Height="2" VerticalAlignment="Bottom" Fill="#FF5E4B2A"/>
          </Grid>

          <Grid Grid.Row="1" Margin="40,18,40,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="34"/>
              <ColumnDefinition Width="294"/>
            </Grid.ColumnDefinitions>

            <Grid>
              <Border Style="{StaticResource GlueInsetPanelStyle}"/>
              <Grid Margin="20,20,20,20">
                <Grid.RowDefinitions>
                  <RowDefinition Height="34"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="76"/>
                </Grid.RowDefinitions>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="106"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="GAME NAME" Foreground="#FFFCD412" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="PLAYERS" Foreground="#FFFCD412" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="PING" Foreground="#FFFCD412" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>

                <Grid Grid.Row="1">
                  <Border Style="{StaticResource GlueListBoxStyle}"/>
                  <StackPanel Margin="12,10,12,10">
                    <Grid Height="38">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="96"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="No local games found" Foreground="#FFB8B8B8" FontSize="18" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="-" Foreground="#FF777777" FontSize="18" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="2" Text="-" Foreground="#FF777777" FontSize="18" VerticalAlignment="Center"/>
                    </Grid>
                  </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="0,16,0,0">
                  <TextBlock Text="PLAYER NAME" Foreground="#FFFFFFFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Top" Margin="0,4,0,0"/>
                  <Grid Height="38" VerticalAlignment="Bottom" Width="320" HorizontalAlignment="Left" Margin="0,0,0,3">
                    <Border Style="{StaticResource GlueEditBoxStyle}"/>
                    <TextBlock Text="WorldEdit" Foreground="#FFB8B8B8" FontSize="18" VerticalAlignment="Center" Margin="12,0,0,0"/>
                  </Grid>
                </Grid>
              </Grid>
            </Grid>

            <Grid Grid.Column="2">
              <Border Style="{StaticResource GlueInsetPanelStyle}"/>
              <StackPanel Margin="26,30,26,30">
                <Grid x:Name="LanRefreshButton" Height="54" Margin="0,0,0,18">
                  <Border Style="{StaticResource GlueButtonChromeStyle}"/>
                  <Border Margin="22,10" Style="{StaticResource GlueButtonFillStyle}"/>
                  <Border x:Name="GlueMenuButtonHoverLanRefreshButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
                  <Border x:Name="GlueMenuButtonPressedLanRefreshButton" Style="{StaticResource GlueButtonPressedFillStyle}" Visibility="Collapsed" Opacity="0.86"/>
                  <TextBlock Text="Refresh" Foreground="#FFFCD412" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <Grid x:Name="LanCreateGameButton" Height="54" Margin="0,0,0,18">
                  <Border Style="{StaticResource GlueButtonChromeStyle}"/>
                  <Border Margin="22,10" Style="{StaticResource GlueButtonFillStyle}"/>
                  <Border x:Name="GlueMenuButtonHoverLanCreateGameButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
                  <Border x:Name="GlueMenuButtonPressedLanCreateGameButton" Style="{StaticResource GlueButtonPressedFillStyle}" Visibility="Collapsed" Opacity="0.86"/>
                  <TextBlock Text="Create Game" Foreground="#FFFCD412" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <Grid x:Name="LanJoinGameButton" Height="54" Margin="0,0,0,30">
                  <Border Style="{StaticResource GlueButtonChromeStyle}"/>
                  <Border Margin="22,10" Style="{StaticResource GlueButtonDisabledFillStyle}"/>
                  <Border x:Name="GlueMenuButtonHoverLanJoinGameButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
                  <Border x:Name="GlueMenuButtonPressedLanJoinGameButton" Style="{StaticResource GlueButtonPressedFillStyle}" Visibility="Collapsed" Opacity="0.86"/>
                  <TextBlock Text="Join Game" Foreground="#FF8C8C8C" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <Border Height="1" Background="#FF384456" Margin="12,0,12,24"/>
                <TextBlock Text="STATUS" Foreground="#FFFCD412" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock Text="Searching for games on your local network."
                           Foreground="#FFFFFFFF" FontSize="17" TextWrapping="Wrap" LineHeight="23"/>
              </StackPanel>
            </Grid>
          </Grid>

          <Grid Grid.Row="2">
            <Grid x:Name="QuitLocalAreaNetworkButton" Width="344" Height="60" HorizontalAlignment="Right" VerticalAlignment="Bottom">
              <Border Style="{StaticResource GlueButtonChromeStyle}"/>
              <Border Margin="28,11" Style="{StaticResource GlueButtonFillStyle}"/>
              <Border Margin="22,9" Style="{StaticResource GlueButtonFillStyle}"/>
              <Border x:Name="GlueMenuButtonHoverQuitLocalAreaNetworkButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
              <Border x:Name="GlueMenuButtonPressedQuitLocalAreaNetworkButton" Style="{StaticResource GlueButtonPressedFillStyle}" Visibility="Collapsed" Opacity="0.86"/>
              <TextBlock Text="Cancel" Foreground="#FFFCD412" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Canvas>
  </Grid>
</UserControl>
