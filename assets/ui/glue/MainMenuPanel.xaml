<UserControl
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="War3UI.MainMenuPanelControl">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../GlueMenuResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Width="1536" Height="1152">
    <Canvas>
      <Rectangle Canvas.Left="82" Canvas.Top="58" Width="560" Height="280"
                 Fill="{StaticResource War3xLogoBrush}"/>

      <!-- UI\FrameDef\Glue\MainMenu.fdf: StandardMenuButtonBaseBackdrop at TOPRIGHT -0.015,-0.110625 -->
      <Rectangle Canvas.Left="1016" Canvas.Top="212" Width="492" Height="123" Fill="{StaticResource GlueButton1BorderBrush}"/>
      <Grid x:Name="SinglePlayerButton" Canvas.Left="1140" Canvas.Top="244" Width="344" Height="60">
        <Border Style="{StaticResource GlueButtonChromeStyle}"/>
        <Border Margin="28,11" Style="{StaticResource GlueButtonFillStyle}"/>
        <Border Margin="22,9" Style="{StaticResource GlueButtonFillStyle}"/>
        <Border x:Name="GlueMenuButtonHoverSinglePlayerButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
        <Border x:Name="GlueMenuButtonPressedSinglePlayerButton" Style="{StaticResource GlueButtonPressedFillStyle}" Visibility="Collapsed" Opacity="0.86"/>
        <TextBlock Text="Single Player" Foreground="#FFFCD412" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>

      <Rectangle Canvas.Left="1016" Canvas.Top="326" Width="492" Height="123" Fill="{StaticResource GlueButton1BorderBrush}"/>
      <Grid x:Name="BattleNetButton" Canvas.Left="1140" Canvas.Top="358" Width="344" Height="60">
        <Border Style="{StaticResource GlueButtonChromeStyle}"/>
        <Border Margin="28,11" Style="{StaticResource GlueButtonFillStyle}"/>
        <Border Margin="22,9" Style="{StaticResource GlueButtonFillStyle}"/>
        <Border x:Name="GlueMenuButtonHoverBattleNetButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
        <Border x:Name="GlueMenuButtonPressedBattleNetButton" Style="{StaticResource GlueButtonPressedFillStyle}" Visibility="Collapsed" Opacity="0.86"/>
        <TextBlock Text="Battle.net" Foreground="#FFFCD412" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>

      <Rectangle Canvas.Left="1016" Canvas.Top="440" Width="492" Height="123" Fill="{StaticResource GlueButton1BorderBrush}"/>
      <Grid x:Name="LocalAreaNetworkButton" Canvas.Left="1140" Canvas.Top="472" Width="344" Height="60">
        <Border Style="{StaticResource GlueButtonChromeStyle}"/>
        <Border Margin="28,11" Style="{StaticResource GlueButtonFillStyle}"/>
        <Border Margin="22,9" Style="{StaticResource GlueButtonFillStyle}"/>
        <Border x:Name="GlueMenuButtonHoverLocalAreaNetworkButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
        <Border x:Name="GlueMenuButtonPressedLocalAreaNetworkButton" Style="{StaticResource GlueButtonPressedFillStyle}" Visibility="Collapsed" Opacity="0.86"/>
        <TextBlock Text="Local Area Network" Foreground="#FFFCD412" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>

      <Rectangle Canvas.Left="1016" Canvas.Top="554" Width="492" Height="123" Fill="{StaticResource GlueButton1BorderBrush}"/>
      <Grid x:Name="OptionsButton" Canvas.Left="1140" Canvas.Top="586" Width="344" Height="60">
        <Border Style="{StaticResource GlueButtonChromeStyle}"/>
        <Border Margin="28,11" Style="{StaticResource GlueButtonFillStyle}"/>
        <Border Margin="22,9" Style="{StaticResource GlueButtonFillStyle}"/>
        <Border x:Name="GlueMenuButtonHoverOptionsButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
        <Border x:Name="GlueMenuButtonPressedOptionsButton" Style="{StaticResource GlueButtonPressedFillStyle}" Visibility="Collapsed" Opacity="0.86"/>
        <TextBlock Text="Options" Foreground="#FFFCD412" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>

      <Rectangle Canvas.Left="1016" Canvas.Top="668" Width="492" Height="123" Fill="{StaticResource GlueButton1BorderBrush}"/>
      <Grid x:Name="CreditsButton" Canvas.Left="1140" Canvas.Top="700" Width="344" Height="60">
        <Border Style="{StaticResource GlueButtonChromeStyle}"/>
        <Border Margin="28,11" Style="{StaticResource GlueButtonDisabledFillStyle}"/>
        <Border Margin="22,9" Style="{StaticResource GlueButtonDisabledFillStyle}"/>
        <Border x:Name="GlueMenuButtonHoverCreditsButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
        <Border x:Name="GlueMenuButtonPressedCreditsButton" Style="{StaticResource GlueButtonPressedFillStyle}" Visibility="Collapsed" Opacity="0.86"/>
        <TextBlock Text="Credits" Foreground="#FF8C8C8C" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>

      <!-- UI\FrameDef\Glue\MainMenu.fdf: ExitBackdrop at BOTTOMRIGHT -0.015,0.05 -->
      <Rectangle Canvas.Left="1046" Canvas.Top="933" Width="461" Height="123" Fill="{StaticResource GlueButton1BorderSingleBrush}"/>
      <Grid x:Name="ExitButton" Canvas.Left="1162" Canvas.Top="965" Width="323" Height="60">
        <Border Style="{StaticResource GlueButtonChromeStyle}"/>
        <Border Margin="28,11" Style="{StaticResource GlueButtonFillStyle}"/>
        <Border Margin="22,9" Style="{StaticResource GlueButtonFillStyle}"/>
        <Border x:Name="GlueMenuButtonHoverExitButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
        <Border x:Name="GlueMenuButtonPressedExitButton" Style="{StaticResource GlueButtonPressedFillStyle}" Visibility="Collapsed" Opacity="0.86"/>
        <TextBlock Text="Quit" Foreground="#FFFCD412" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>

      <Grid x:Name="QuitConfirmDialog" Canvas.Left="470" Canvas.Top="408" Width="596" Height="328" Visibility="Collapsed">
        <Border Style="{StaticResource GluePanelFrameStyle}"/>
        <Border Margin="12" Background="{StaticResource GluePanelMetalPiecesExpansionBrush}" Opacity="0.68"/>
        <Border Margin="23" Style="{StaticResource GlueInsetPanelStyle}"/>
        <Border Margin="22,24,22,244" Background="{StaticResource GluePanelGearRailBrush}" Opacity="0.70"/>
        <TextBlock Text="Quit Warcraft III?" Canvas.Left="0" Canvas.Top="0"
                   Foreground="#FFFCD412" FontSize="28" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,54,0,0"/>
        <TextBlock Text="Are you sure you want to quit?"
                   Foreground="#FFE8E0C8" FontSize="21" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,126,0,0"/>

        <Grid x:Name="QuitConfirmOKButton" HorizontalAlignment="Left" VerticalAlignment="Bottom"
              Margin="88,0,0,50" Width="188" Height="58">
          <Border Style="{StaticResource GlueButtonChromeStyle}"/>
          <Border Margin="25,10" Style="{StaticResource GlueButtonFillStyle}"/>
          <Border Margin="19,8" Style="{StaticResource GlueButtonFillStyle}"/>
          <Border x:Name="GlueMenuButtonHoverQuitConfirmOKButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
          <Border x:Name="GlueMenuButtonPressedQuitConfirmOKButton" Style="{StaticResource GlueButtonPressedFillStyle}" Visibility="Collapsed" Opacity="0.86"/>
          <TextBlock Text="OK" Foreground="#FFFCD412" FontSize="22" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <Grid x:Name="QuitConfirmCancelButton" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="0,0,88,50" Width="188" Height="58">
          <Border Style="{StaticResource GlueButtonChromeStyle}"/>
          <Border Margin="25,10" Style="{StaticResource GlueButtonFillStyle}"/>
          <Border Margin="19,8" Style="{StaticResource GlueButtonFillStyle}"/>
          <Border x:Name="GlueMenuButtonHoverQuitConfirmCancelButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
          <Border x:Name="GlueMenuButtonPressedQuitConfirmCancelButton" Style="{StaticResource GlueButtonPressedFillStyle}" Visibility="Collapsed" Opacity="0.86"/>
          <TextBlock Text="Cancel" Foreground="#FFFCD412" FontSize="22" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
      </Grid>
    </Canvas>
  </Grid>
</UserControl>
