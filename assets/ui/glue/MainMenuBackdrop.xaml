<UserControl
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="War3UI.MainMenuBackdropControl">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../GlueMenuResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Background="#00000000" IsHitTestVisible="False">
    <Viewbox Stretch="UniformToFill">
      <Grid Width="1536" Height="1152">
        <Canvas>
          <Rectangle Canvas.Left="0" Canvas.Top="0" Width="1536" Height="1152"
                     Fill="#22000000"/>

          <Rectangle Canvas.Left="0" Canvas.Top="0" Width="512" Height="74"
                     Fill="{StaticResource GlueProfileStretchBrush}" Opacity="0.74"/>
          <Rectangle Canvas.Left="512" Canvas.Top="0" Width="512" Height="74"
                     Fill="{StaticResource GlueProfileStretch2Brush}" Opacity="0.58"/>
          <Rectangle Canvas.Left="-18" Canvas.Top="-12" Width="228" Height="92"
                     Fill="{StaticResource GlueProfileEndCapsBrush}" Opacity="0.76"/>
          <Rectangle Canvas.Left="1326" Canvas.Top="-12" Width="228" Height="92"
                     Fill="{StaticResource GlueProfileEndCapsBrush}" Opacity="0.72">
            <Rectangle.RenderTransform>
              <ScaleTransform ScaleX="-1" CenterX="114"/>
            </Rectangle.RenderTransform>
          </Rectangle>

          <Rectangle Canvas.Left="1006" Canvas.Top="154" Width="520" Height="680"
                     Fill="{StaticResource GluePanelBNetChannelBrush}" Opacity="0.18"/>
          <Rectangle Canvas.Left="1030" Canvas.Top="190" Width="452" Height="548"
                     Fill="#D8060708"/>
          <Rectangle Canvas.Left="1018" Canvas.Top="176" Width="476" Height="36"
                     Fill="{StaticResource GluePanelMetalPiecesExpansionBrush}" Opacity="0.82"/>
          <Rectangle Canvas.Left="1018" Canvas.Top="728" Width="476" Height="44"
                     Fill="{StaticResource GluePanelMetalPiecesExpansionBrush}" Opacity="0.78"/>
          <Rectangle Canvas.Left="990" Canvas.Top="172" Width="34" Height="640"
                     Fill="{StaticResource GluePanelMetalBorderExpansionBrush}" Opacity="0.78"/>
          <Rectangle Canvas.Left="1492" Canvas.Top="172" Width="34" Height="640"
                     Fill="{StaticResource GluePanelMetalBorderExpansionBrush}" Opacity="0.78"/>
          <Rectangle Canvas.Left="1010" Canvas.Top="156" Width="494" Height="38"
                     Fill="{StaticResource GlueCenterPanel01ExpansionBrush}" Opacity="0.66"/>
          <Rectangle Canvas.Left="1010" Canvas.Top="802" Width="494" Height="38"
                     Fill="{StaticResource GlueCenterPanel03ExpansionBrush}" Opacity="0.62"/>
          <Rectangle Canvas.Left="1070" Canvas.Top="-18" Width="34" Height="230"
                     Fill="{StaticResource MainMenuChainsSilverBrush}" Opacity="0.30"/>
          <Rectangle Canvas.Left="1260" Canvas.Top="-18" Width="34" Height="230"
                     Fill="{StaticResource MainMenuChainsSilverBrush}" Opacity="0.30"/>

          <Rectangle Canvas.Left="982" Canvas.Top="876" Width="560" Height="226"
                     Fill="{StaticResource MainMenuSnowyRocksDull2Brush}" Opacity="0.42"/>
          <Rectangle Canvas.Left="958" Canvas.Top="904" Width="588" Height="160"
                     Fill="{StaticResource MainMenuIceNatural01Brush}" Opacity="0.34"/>
          <Rectangle Canvas.Left="1034" Canvas.Top="922" Width="492" Height="154"
                     Fill="{StaticResource GluePanelMetalPiecesExpansionBrush}" Opacity="0.54"/>
          <Rectangle Canvas.Left="1048" Canvas.Top="936" Width="462" Height="126"
                     Fill="{StaticResource GluePanelExpansionDetailBrush}" Opacity="0.42"/>

          <Rectangle Canvas.Left="70" Canvas.Top="96" Width="430" Height="220"
                     Fill="{StaticResource MainMenuBlueGlowBrush}" Opacity="0.10"/>
          <Rectangle Canvas.Left="34" Canvas.Top="986" Width="680" Height="126"
                     Fill="{StaticResource MainMenuOceanH10Brush}" Opacity="0.16"/>
          <Rectangle Canvas.Left="680" Canvas.Top="1014" Width="860" Height="96"
                     Fill="{StaticResource MainMenuOceanH01Brush}" Opacity="0.14"/>
        </Canvas>
      </Grid>
    </Viewbox>
  </Grid>
</UserControl>
