<UserControl
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="War3UI.GlueBattleNetPanelControl">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../GlueMenuResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Width="1536" Height="1152">
    <Canvas>
      <Grid Canvas.Left="246" Canvas.Top="160" Width="1044" Height="768">
        <Border Style="{StaticResource GluePanelFrameStyle}"/>
        <Border Margin="18" Background="{StaticResource GluePanelMetalPiecesExpansionBrush}" Opacity="0.78"/>
        <Border Margin="34" Background="#EA05070A" BorderBrush="#FF283038" BorderThickness="2"/>

        <Grid Margin="74,62,74,62">
          <Grid.RowDefinitions>
            <RowDefinition Height="118"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="98"/>
          </Grid.RowDefinitions>

          <Grid>
            <Rectangle HorizontalAlignment="Left" Width="260" Height="2" VerticalAlignment="Bottom" Fill="#FF5E4B2A"/>
            <TextBlock Text="Battle.net" Foreground="#FFFCD412" FontSize="42" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Text="Gateway: Azeroth" Foreground="#FFFFFFFF" FontSize="17"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
            <Rectangle HorizontalAlignment="Right" Width="260" Height="2" VerticalAlignment="Bottom" Fill="#FF5E4B2A"/>
          </Grid>

          <Grid Grid.Row="1" Margin="40,18,40,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="430"/>
              <ColumnDefinition Width="34"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid>
              <Border Style="{StaticResource GlueInsetPanelStyle}"/>
              <StackPanel Margin="28,28,28,28">
                <TextBlock Text="LOG ON TO BATTLE.NET" Foreground="#FFFCD412" FontSize="23" FontWeight="Bold" Margin="0,0,0,20"/>
                <TextBlock Text="ACCOUNT NAME" Foreground="#FFFFFFFF" FontSize="16" FontWeight="Bold"/>
                <Grid Height="42" Margin="0,6,0,18">
                  <Border Style="{StaticResource GlueEditBoxStyle}"/>
                  <TextBlock Text="WorldEdit" Foreground="#FFB8B8B8" FontSize="18" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
                <TextBlock Text="PASSWORD" Foreground="#FFFFFFFF" FontSize="16" FontWeight="Bold"/>
                <Grid Height="42" Margin="0,6,0,24">
                  <Border Style="{StaticResource GlueEditBoxStyle}"/>
                  <TextBlock Text="********" Foreground="#FF777777" FontSize="18" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>

                <Grid x:Name="BattleNetLogonButton" Height="54" Margin="18,0,18,14">
                  <Border Style="{StaticResource GlueButtonChromeStyle}"/>
                  <Border Margin="22,10" Style="{StaticResource GlueButtonFillStyle}"/>
                  <Border x:Name="GlueMenuButtonHoverBattleNetLogonButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
                  <Border x:Name="GlueMenuButtonPressedBattleNetLogonButton" Style="{StaticResource GlueButtonPressedFillStyle}" Visibility="Collapsed" Opacity="0.86"/>
                  <TextBlock Text="Logon" Foreground="#FFFCD412" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <Grid x:Name="BattleNetCreateAccountButton" Height="48" Margin="38,0,38,10">
                  <Border Style="{StaticResource GlueButtonChromeStyle}"/>
                  <Border Margin="18,9" Style="{StaticResource GlueButtonFillStyle}"/>
                  <Border x:Name="GlueMenuButtonHoverBattleNetCreateAccountButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
                  <Border x:Name="GlueMenuButtonPressedBattleNetCreateAccountButton" Style="{StaticResource GlueButtonPressedFillStyle}" Visibility="Collapsed" Opacity="0.86"/>
                  <TextBlock Text="Create New Account" Foreground="#FFFCD412" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <Grid x:Name="BattleNetRecoverPasswordButton" Height="44" Margin="58,0,58,0">
                  <Border Style="{StaticResource GlueButtonChromeStyle}"/>
                  <Border Margin="16,8" Style="{StaticResource GlueButtonDisabledFillStyle}"/>
                  <Border x:Name="GlueMenuButtonHoverBattleNetRecoverPasswordButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
                  <Border x:Name="GlueMenuButtonPressedBattleNetRecoverPasswordButton" Style="{StaticResource GlueButtonPressedFillStyle}" Visibility="Collapsed" Opacity="0.86"/>
                  <TextBlock Text="Recover Password" Foreground="#FF8C8C8C" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
            </Grid>

            <Grid Grid.Column="2">
              <Border Style="{StaticResource GlueInsetPanelStyle}"/>
              <StackPanel Margin="30,28,30,28">
                <TextBlock Text="NEWS" Foreground="#FFFCD412" FontSize="23" FontWeight="Bold" Margin="0,0,0,18"/>
                <TextBlock Text="Unable to connect to Battle.net."
                           Foreground="#FFFFFFFF" FontSize="18" TextWrapping="Wrap" LineHeight="24" Margin="0,0,0,22"/>
                <TextBlock Text="News from Azeroth will appear here when a gateway connection is available."
                           Foreground="#FFB8B8B8" FontSize="17" TextWrapping="Wrap" LineHeight="23"/>
                <Border Height="1" Background="#FF384456" Margin="0,30,0,24"/>
                <TextBlock Text="REALM STATUS" Foreground="#FFFCD412" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                  <Border Width="14" Height="14" Background="#FF286EA8" BorderBrush="#FF80B8FF" BorderThickness="1" Margin="0,4,10,0"/>
                  <TextBlock Text="Gateway unavailable" Foreground="#FFFFFFFF" FontSize="17"/>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Grid>

          <Grid Grid.Row="2">
            <Grid x:Name="QuitBattleNetButton" Width="344" Height="60" HorizontalAlignment="Right" VerticalAlignment="Bottom">
              <Border Style="{StaticResource GlueButtonChromeStyle}"/>
              <Border Margin="28,11" Style="{StaticResource GlueButtonFillStyle}"/>
              <Border Margin="22,9" Style="{StaticResource GlueButtonFillStyle}"/>
              <Border x:Name="GlueMenuButtonHoverQuitBattleNetButton" Background="{StaticResource GlueButtonKeyboardHighlightBrush}" Visibility="Collapsed" Opacity="0.72"/>
              <Border x:Name="GlueMenuButtonPressedQuitBattleNetButton" Style="{StaticResource GlueButtonPressedFillStyle}" Visibility="Collapsed" Opacity="0.86"/>
              <TextBlock Text="Cancel" Foreground="#FFFCD412" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Canvas>
  </Grid>
</UserControl>
