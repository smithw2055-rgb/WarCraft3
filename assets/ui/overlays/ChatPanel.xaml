    <Border x:Name="ChatPanel"
            Width="396"
            Height="156"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Margin="22,0,0,248"
            Background="{StaticResource TooltipBackgroundBrush}"
            BorderBrush="{StaticResource TooltipBorderBrush}"
            BorderThickness="2"
            CornerRadius="10"
            Padding="10"
            Visibility="Collapsed">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="ChatLogText"
                   Foreground="#FFD9E1EA"
                   FontSize="12"
                   TextWrapping="Wrap"/>
        <TextBox x:Name="ChatInputBox"
                 Grid.Row="1"
                 Height="30"
                 Margin="0,8,0,0"
                 Background="{StaticResource TooltipBackgroundBrush}"
                 Foreground="#FFF1F5FA"
                 BorderBrush="{StaticResource TooltipBorderBrush}"
                 BorderThickness="2"
                 FontSize="12"/>
      </Grid>
    </Border>
