<Border x:Name="TooltipPanel"
        Width="260"
        Background="{StaticResource TooltipBackgroundBrush}"
        BorderBrush="{StaticResource TooltipBorderBrush}"
        BorderThickness="2"
        CornerRadius="4"
        Padding="10,8"
        Visibility="Collapsed">
  <StackPanel>
    <TextBlock x:Name="TooltipText"
               Foreground="#FFF1E3B2"
               TextWrapping="Wrap"
               FontSize="14"/>
    <StackPanel x:Name="TooltipResourceRow"
                Orientation="Horizontal"
                Margin="0,8,0,0"
                Visibility="Collapsed">
      <StackPanel x:Name="TooltipGoldCost" Orientation="Horizontal" Margin="0,0,12,0" Visibility="Collapsed">
        <Border Width="14" Height="14" Margin="0,0,4,0" Background="{StaticResource TooltipGoldIconBrush}"/>
        <TextBlock x:Name="TooltipGoldCostText" Foreground="#FFFCE680" FontSize="12" FontWeight="Bold"/>
      </StackPanel>
      <StackPanel x:Name="TooltipLumberCost" Orientation="Horizontal" Margin="0,0,12,0" Visibility="Collapsed">
        <Border Width="14" Height="14" Margin="0,0,4,0" Background="{StaticResource TooltipLumberIconBrush}"/>
        <TextBlock x:Name="TooltipLumberCostText" Foreground="#FFD8F0A6" FontSize="12" FontWeight="Bold"/>
      </StackPanel>
      <StackPanel x:Name="TooltipStoneCost" Orientation="Horizontal" Margin="0,0,12,0" Visibility="Collapsed">
        <Border Width="14" Height="14" Margin="0,0,4,0" Background="{StaticResource TooltipStonesIconBrush}"/>
        <TextBlock x:Name="TooltipStoneCostText" Foreground="#FFE2DED4" FontSize="12" FontWeight="Bold"/>
      </StackPanel>
      <StackPanel x:Name="TooltipManaCost" Orientation="Horizontal" Margin="0,0,12,0" Visibility="Collapsed">
        <Border Width="14" Height="14" Margin="0,0,4,0" Background="{StaticResource TooltipManaIconBrush}"/>
        <TextBlock x:Name="TooltipManaCostText" Foreground="#FFAAD7FF" FontSize="12" FontWeight="Bold"/>
      </StackPanel>
      <StackPanel x:Name="TooltipFoodCost" Orientation="Horizontal" Visibility="Collapsed">
        <Border Width="14" Height="14" Margin="0,0,4,0" Background="{StaticResource TooltipSupplyIconBrush}"/>
        <TextBlock x:Name="TooltipFoodCostText" Foreground="#FFF3F7FF" FontSize="12" FontWeight="Bold"/>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</Border>
